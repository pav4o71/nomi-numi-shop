{
  "name": "nomi-numi-shop",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:e2e": "next dev --hostname 127.0.0.1 --port 3101",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "mkdir -p var/tmp && TMPDIR=\"$PWD/var/tmp\" vitest run",
    "test:ci": "mkdir -p var/tmp && TMPDIR=\"$PWD/var/tmp\" vitest run --exclude tests/unit/database-safety.test.ts --exclude tests/unit/drizzle-foundation.test.ts --exclude tests/unit/email-local-safety.test.ts",
    "test:watch": "mkdir -p var/tmp && TMPDIR=\"$PWD/var/tmp\" vitest",
    "test:e2e": "mkdir -p var/playwright-browsers var/tmp && PLAYWRIGHT_BROWSERS_PATH=var/playwright-browsers TMPDIR=\"$PWD/var/tmp\" playwright test",
    "test:e2e:install": "mkdir -p var/playwright-browsers var/tmp && PLAYWRIGHT_BROWSERS_PATH=var/playwright-browsers TMPDIR=\"$PWD/var/tmp\" playwright install chromium",
    "test:all": "pnpm test && pnpm test:e2e",
    "db:dev:up": "./scripts/db-local.sh dev up",
    "db:dev:stop": "./scripts/db-local.sh dev stop",
    "db:dev:status": "./scripts/db-local.sh dev status",
    "db:test:up": "./scripts/db-local.sh test up",
    "db:test:stop": "./scripts/db-local.sh test stop",
    "db:test:status": "./scripts/db-local.sh test status",
    "db:generate": "./scripts/drizzle-local.sh generate",
    "db:check": "./scripts/drizzle-local.sh check",
    "db:dev:migrate": "./scripts/drizzle-local.sh migrate dev",
    "db:test:migrate": "./scripts/drizzle-local.sh migrate test",
    "db:test:rebuild": "./scripts/db-test-rebuild.sh",
    "email:up": "./scripts/email-local.sh up",
    "email:stop": "./scripts/email-local.sh stop",
    "email:status": "./scripts/email-local.sh status"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
