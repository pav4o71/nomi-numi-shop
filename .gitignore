# ==========================================================
# nomi-numi-shop
# Git exclusions
# ==========================================================

# Dependencies
/node_modules/

# Next.js
/.next/
/out/

# Build output
/dist/
/build/

# Testing / coverage
/coverage/
/playwright-report/
/test-results/
/blob-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment / secrets
.env
.env.*
!.env.example
!.env.*.example

# Local runtime data
/data/
/var/
/backups/

# Local database artifacts
*.sqlite
*.sqlite3
*.db

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# IDE-local state
.idea/

# TypeScript cache
*.tsbuildinfo

# Next.js generated env typings may be recreated
next-env.d.ts
