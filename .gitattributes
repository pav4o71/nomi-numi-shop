# Normalize text files to LF in the repository.
* text=auto eol=lf

# Source / configuration
*.sh text eol=lf
*.md text eol=lf
*.mdc text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env.example text eol=lf

# Binary media
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.svg text eol=lf
*.mp4 binary
*.mov binary
*.webm binary
*.pdf binary
*.zip binary
*.gz binary
