# Nomi Numi Shop — local environment template (placeholders only)
#
# Copy values into ignored `.env.local` for Phase 2A local auth runtime.
# Never commit real secrets or credential-bearing DATABASE_URL values.

# High-entropy secret, at least 32 characters.
# Generate locally, for example with Node crypto.randomBytes(32).toString("base64url")
BETTER_AUTH_SECRET=REPLACE_ME_WITH_A_GENERATED_SECRET

# Phase 2A local origin only (explicit; no request-header inference).
# Allowed: http://127.0.0.1:3100 (pnpm dev) or http://127.0.0.1:3101 (pnpm dev:e2e).
BETTER_AUTH_URL=http://127.0.0.1:3100

# Local DEV PostgreSQL only:
# host 127.0.0.1
# port 55432
# database nomi_numi_shop_dev
# user nomi_numi_dev
# password from ignored var/docker/dev.env (never commit)
DATABASE_URL=postgresql://nomi_numi_dev:replace-with-local-dev-password@127.0.0.1:55432/nomi_numi_shop_dev

# Phase 2C1/2C2 local Mailpit transport (no production provider).
# Start with: pnpm email:up
# SMTP 127.0.0.1:11025  UI http://127.0.0.1:18025
# Required when Better Auth sends verification or password-reset mail.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@nomi-numi.local
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
